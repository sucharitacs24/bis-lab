        "!pip install numpy matplotlib\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ==========================================\n",
        "# 1. PROBLEM CONFIGURATION\n",
        "# ==========================================\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "NUM_VARIABLES = 20\n",
        "POPULATION_SIZE = 50\n",
        "GENERATIONS = 100\n",
        "\n",
        "CROSSOVER_RATE = 0.8\n",
        "MUTATION_RATE = 0.05\n",
        "ERROR_LIMIT = 0.025\n",
        "\n",
        "# Error contribution of each variable when\n",
        "# converted from FP64 to FP32.\n",
        "error_cost = np.random.uniform(\n",
        "    0.0002, 0.004, NUM_VARIABLES\n",
        ")\n",
        "\n",
        "# Performance benefit of using FP32\n",
        "speed_benefit = np.random.uniform(\n",
        "    1.0, 3.0, NUM_VARIABLES\n",
        ")\n",
        "\n",
        "# Chromosome:\n",
        "# 1 = FP32 (single precision)\n",
        "# 0 = FP64 (double precision)\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. FITNESS FUNCTION\n",
        "# ==========================================\n",
        "\n",
        "def calculate_error(chromosome):\n",
        "    return np.sum(chromosome * error_cost)\n",
        "\n",
        "\n",
        "def calculate_benefit(chromosome):\n",
        "    return np.sum(chromosome * speed_benefit)\n",
        "\n",
        "\n",
        "def fitness(chromosome):\n",
        "\n",
        "    error = calculate_error(chromosome)\n",
        "    benefit = calculate_benefit(chromosome)\n",
        "\n",
        "    if error <= ERROR_LIMIT:\n",
        "        return benefit\n",
        "\n",
        "    # Penalize solutions exceeding error limit\n",
        "    penalty = 1000 * (error - ERROR_LIMIT)\n",
        "\n",
        "    return benefit - penalty\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. INITIAL POPULATION\n",
        "# ==========================================\n",
        "\n",
        "population = np.random.randint(\n",
        "    0, 2,\n",
        "    size=(POPULATION_SIZE, NUM_VARIABLES)\n",
        ")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 4. SELECTION - TOURNAMENT SELECTION\n",
        "# ==========================================\n",
        "\n",
        "def selection(population):\n",
        "\n",
        "    candidates = np.random.choice(\n",
        "        len(population), 3, replace=False\n",
        "    )\n",
        "\n",
        "    best = max(\n",
        "        candidates,\n",
        "        key=lambda i: fitness(population[i])\n",
        "    )\n",
        "\n",
        "    return population[best].copy()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 5. CROSSOVER - UNIFORM CROSSOVER\n",
        "# ==========================================\n",
        "\n",
        "def crossover(parent1, parent2):\n",
        "\n",
        "    child1 = parent1.copy()\n",
        "    child2 = parent2.copy()\n",
        "\n",
        "    if np.random.rand() < CROSSOVER_RATE:\n",
        "\n",
        "        mask = np.random.randint(\n",
        "            0, 2, NUM_VARIABLES\n",
        "        ).astype(bool)\n",
        "\n",
        "        child1[mask] = parent2[mask]\n",
        "        child2[mask] = parent1[mask]\n",
        "\n",
        "    return child1, child2\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 6. MUTATION\n",
        "# ==========================================\n",
        "\n",
        "def mutation(chromosome):\n",
        "\n",
        "    for i in range(NUM_VARIABLES):\n",
        "\n",
        "        if np.random.rand() < MUTATION_RATE:\n",
        "\n",
        "            chromosome[i] = 1 - chromosome[i]\n",
        "\n",
        "    return chromosome\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 7. GENETIC ALGORITHM\n",
        "# ==========================================\n",
        "\n",
        "best_fitness_history = []\n",
        "best_error_history = []\n",
        "best_benefit_history = []\n",
        "\n",
        "best_solution = np.zeros(NUM_VARIABLES)\n",
        "best_solution_fitness = fitness(best_solution)\n",
        "\n",
        "for generation in range(GENERATIONS):\n",
        "\n",
        "    # Evaluate current population\n",
        "    scores = np.array([\n",
        "        fitness(individual)\n",
        "        for individual in population\n",
        "    ])\n",
        "\n",
        "    # Find generation's best individual\n",
        "    best_index = np.argmax(scores)\n",
        "    generation_best = population[best_index].copy()\n",
        "\n",
        "    # Keep best solution found so far\n",
        "    if fitness(generation_best) > best_solution_fitness:\n",
        "        best_solution = generation_best.copy()\n",
        "        best_solution_fitness = fitness(best_solution)\n",
        "\n",
        "    # Create next generation\n",
        "    new_population = [\n",
        "        best_solution.copy()\n",
        "    ]\n",
        "\n",
        "    while len(new_population) < POPULATION_SIZE:\n",
        "\n",
        "        parent1 = selection(population)\n",
        "        parent2 = selection(population)\n",
        "\n",
        "        child1, child2 = crossover(\n",
        "            parent1, parent2\n",
        "        )\n",
        "\n",
        "        child1 = mutation(child1)\n",
        "        child2 = mutation(child2)\n",
        "\n",
        "        new_population.append(child1)\n",
        "\n",
        "        if len(new_population) < POPULATION_SIZE:\n",
        "            new_population.append(child2)\n",
        "\n",
        "    population = np.array(new_population)\n",
        "\n",
        "    # Record results of best-so-far solution\n",
        "    best_fitness_history.append(\n",
        "        fitness(best_solution)\n",
        "    )\n",
        "\n",
        "    best_error_history.append(\n",
        "        calculate_error(best_solution)\n",
        "    )\n",
        "\n",
        "    best_benefit_history.append(\n",
        "        calculate_benefit(best_solution)\n",
        "    )\n",
        "\n",
        "    if generation % 10 == 0:\n",
        "        print(\n",
        "            f\"Generation {generation}: \"\n",
        "            f\"Fitness = {fitness(best_solution):.4f}, \"\n",
        "            f\"Error = {calculate_error(best_solution):.5f}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 8. FINAL RESULTS\n",
        "# ==========================================\n",
        "\n",
        "final_error = calculate_error(best_solution)\n",
        "final_benefit = calculate_benefit(best_solution)\n",
        "\n",
        "fp32_count = np.sum(best_solution == 1)\n",
        "fp64_count = np.sum(best_solution == 0)\n",
        "\n",
        "print(\"\\n========== FINAL RESULTS ==========\")\n",
        "\n",
        "print(\"Best chromosome:\", best_solution)\n",
        "\n",
        "print(\"FP32 variables:\", fp32_count)\n",
        "print(\"FP64 variables:\", fp64_count)\n",
        "\n",
        "print(\"Total numerical error:\", round(final_error, 6))\n",
        "print(\"Allowed error:\", ERROR_LIMIT)\n",
        "\n",
        "print(\"Performance benefit:\", round(final_benefit, 4))\n",
        "\n",
        "print(\n",
        "    \"Error constraint satisfied:\",\n",
        "    final_error <= ERROR_LIMIT\n",
        ")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 9. GRAPH 1 - GA CONVERGENCE\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    best_fitness_history,\n",
        "    color=\"blue\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Generation\")\n",
        "plt.ylabel(\"Best Fitness\")\n",
        "plt.title(\"Genetic Algorithm Convergence\")\n",
        "\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"ga_convergence.png\", dpi=300)\n",
        "plt.show()\n"
      ],
