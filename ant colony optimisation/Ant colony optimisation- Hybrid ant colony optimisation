        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "class EnhancedACO_TSP:\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        cities: np.ndarray,\n",
        "        num_ants: int = None,\n",
        "        n_iterations: int = 100,\n",
        "        alpha: float = 1.0,\n",
        "        beta: float = 2.0,\n",
        "        rho_min: float = 0.1,\n",
        "        rho_max: float = 0.5,\n",
        "        q: float = 100.0,\n",
        "    ):\n",
        "        \"\"\"Enhanced Ant Colony Optimization with Dynamic Evaporation and 2-Opt.\n",
        "\n",
        "        :param cities: (N, 2) array of city coordinates.\n",
        "        :param num_ants: Number of ants (defaults to 1.2 * N based on research\n",
        "        benchmarks).\n",
        "        \"\"\"\n",
        "        self.cities = cities\n",
        "        self.num_cities = len(cities)\n",
        "        self.num_ants = num_ants if num_ants else int(1.2 * self.num_cities)\n",
        "        self.n_iterations = n_iterations\n",
        "        self.alpha = alpha\n",
        "        self.beta = beta\n",
        "        self.rho_min = rho_min\n",
        "        self.rho_max = rho_max\n",
        "        self.q = q\n",
        "\n",
        "        # Compute distance matrix\n",
        "        self.dist_matrix = np.linalg.norm(\n",
        "            cities[:, np.newaxis, :] - cities[np.newaxis, :, :], axis=-1\n",
        "        )\n",
        "        with np.errstate(divide=\"ignore\"):\n",
        "            self.eta = np.where(\n",
        "                self.dist_matrix != 0, 1.0 / self.dist_matrix, 0.0\n",
        "            )\n",
        "\n",
        "        self.pheromone = np.ones((self.num_cities, self.num_cities))\n",
        "\n",
        "    def _select_next_city(\n",
        "        self, current_city: int, unvisited: list[int]\n",
        "    ) -> int:\n",
        "        pheromones = self.pheromone[current_city, unvisited] ** self.alpha\n",
        "        heuristics = self.eta[current_city, unvisited] ** self.beta\n",
        "        probabilities = pheromones * heuristics\n",
        "\n",
        "        prob_sum = np.sum(probabilities)\n",
        "        if prob_sum == 0:\n",
        "            probabilities = np.ones(len(unvisited)) / len(unvisited)\n",
        "        else:\n",
        "            probabilities /= prob_sum\n",
        "\n",
        "        return np.random.choice(unvisited, p=probabilities)\n",
        "\n",
        "    def _two_opt_local_search(self, tour: list[int]) -> tuple[list[int], float]:\n",
        "        \"\"\"Local Search Operator (2-Opt): Uncrosses intersecting edges.\"\"\"\n",
        "        best_tour = tour[:-1]\n",
        "        best_dist = self._calculate_tour_distance(tour)\n",
        "        improved = True\n",
        "\n",
        "        while improved:\n",
        "            improved = False\n",
        "            for i in range(1, len(best_tour) - 1):\n",
        "                for j in range(i + 1, len(best_tour)):\n",
        "                    c1, c2 = best_tour[i - 1], best_tour[i]\n",
        "                    c3, c4 = best_tour[j], best_tour[(j + 1) % len(best_tour)]\n",
        "\n",
        "                    old_cost = (\n",
        "                        self.dist_matrix[c1, c2] + self.dist_matrix[c3, c4]\n",
        "                    )\n",
        "                    new_cost = (\n",
        "                        self.dist_matrix[c1, c3] + self.dist_matrix[c2, c4]\n",
        "                    )\n",
        "\n",
        "                    if new_cost < old_cost:\n",
        "                        best_tour[i : j + 1] = reversed(best_tour[i : j + 1])\n",
        "                        best_dist += new_cost - old_cost\n",
        "                        improved = True\n",
        "                        break\n",
        "                if improved:\n",
        "                    break\n",
        "\n",
        "        full_tour = best_tour + [best_tour[0]]\n",
        "        return full_tour, self._calculate_tour_distance(full_tour)\n",
        "\n",
        "    def _construct_solution(self) -> tuple[list[int], float]:\n",
        "        start_city = np.random.randint(0, self.num_cities)\n",
        "        tour = [start_city]\n",
        "        unvisited = list(set(range(self.num_cities)) - {start_city})\n",
        "\n",
        "        current = start_city\n",
        "        while unvisited:\n",
        "            next_city = self._select_next_city(current, unvisited)\n",
        "            tour.append(next_city)\n",
        "            unvisited.remove(next_city)\n",
        "            current = next_city\n",
        "\n",
        "        tour.append(start_city)\n",
        "        return self._two_opt_local_search(tour)\n",
        "\n",
        "    def _calculate_tour_distance(self, tour: list[int]) -> float:\n",
        "        return sum(\n",
        "            self.dist_matrix[tour[i], tour[i + 1]] for i in range(len(tour) - 1)\n",
        "        )\n",
        "\n",
        "    def _update_pheromones(\n",
        "        self,\n",
        "        all_tours: list[list[int]],\n",
        "        all_distances: list[float],\n",
        "        best_dist: float,\n",
        "    ):\n",
        "        avg_dist = np.mean(all_distances)\n",
        "        if avg_dist != 0:\n",
        "            rho = self.rho_min + (self.rho_max - self.rho_min) * (\n",
        "                (avg_dist - best_dist) / avg_dist\n",
        "            )\n",
        "        else:\n",
        "            rho = self.rho_min\n",
        "        rho = np.clip(rho, self.rho_min, self.rho_max)\n",
        "\n",
        "        self.pheromone *= 1.0 - rho\n",
        "\n",
        "        for tour, distance in zip(all_tours, all_distances):\n",
        "            deposit = self.q / distance\n",
        "            for i in range(self.num_cities):\n",
        "                c1, c2 = tour[i], tour[i + 1]\n",
        "                self.pheromone[c1, c2] += deposit\n",
        "                self.pheromone[c2, c1] += deposit\n",
        "\n",
        "    def run(self) -> tuple[list[int], float, list[float]]:\n",
        "        best_tour = None\n",
        "        best_distance = float(\"inf\")\n",
        "        history_best_distance = []\n",
        "\n",
        "        for iteration in range(1, self.n_iterations + 1):\n",
        "            all_tours = []\n",
        "            all_distances = []\n",
        "\n",
        "            for _ in range(self.num_ants):\n",
        "                tour, dist = self._construct_solution()\n",
        "                all_tours.append(tour)\n",
        "                all_distances.append(dist)\n",
        "\n",
        "                if dist < best_distance:\n",
        "                    best_distance = dist\n",
        "                    best_tour = tour\n",
        "\n",
        "            history_best_distance.append(best_distance)\n",
        "            self._update_pheromones(all_tours, all_distances, best_distance)\n",
        "\n",
        "            if iteration % 20 == 0 or iteration == 1:\n",
        "                print(\n",
        "                    f\"Iteration {iteration:3d}/{self.n_iterations} | Best Distance: {best_distance:.4f}\"\n",
        "                )\n",
        "\n",
        "        return best_tour, best_distance, history_best_distance\n",
        "\n",
        "\n",
        "# --- Visualization Helper Function ---\n",
        "def plot_aco_results(\n",
        "    cities: np.ndarray, best_tour: list[int], distance_history: list[float]\n",
        "):\n",
        "    \"\"\"Plots both the convergence curve and the physical TSP route.\"\"\"\n",
        "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n",
        "\n",
        "    # Plot 1: Convergence Curve\n",
        "    ax1.plot(\n",
        "        range(1, len(distance_history) + 1),\n",
        "        distance_history,\n",
        "        color=\"crimson\",\n",
        "        linewidth=2,\n",
        "    )\n",
        "    ax1.set_title(\"ACO Convergence Progress\", fontsize=14, fontweight=\"bold\")\n",
        "    ax1.set_xlabel(\"Iteration\", fontsize=12)\n",
        "    ax1.set_ylabel(\"Best Tour Distance\", fontsize=12)\n",
        "    ax1.grid(True, linestyle=\"--\", alpha=0.6)\n",
        "\n",
        "    # Plot 2: Optimal TSP Route Map\n",
        "    tour_coords = cities[best_tour]\n",
        "    ax2.plot(\n",
        "        tour_coords[:, 0],\n",
        "        tour_coords[:, 1],\n",
        "        color=\"royalblue\",\n",
        "        linestyle=\"-\",\n",
        "        linewidth=2,\n",
        "        zorder=1,\n",
        "    )\n",
        "    ax2.scatter(\n",
        "        cities[:, 0],\n",
        "        cities[:, 1],\n",
        "        color=\"darkorange\",\n",
        "        s=80,\n",
        "        zorder=2,\n",
        "        label=\"Cities\",\n",
        "    )\n",
        "\n",
        "    # Annotate City Indices\n",
        "    for i, (x, y) in enumerate(cities):\n",
        "        ax2.annotate(\n",
        "            f\" {i}\", (x, y), fontsize=10, fontweight=\"bold\", color=\"black\"\n",
        "        )\n",
        "\n",
        "    ax2.set_title(\n",
        "        f\"Optimal Path Found (Distance: {distance_history[-1]:.2f})\",\n",
        "        fontsize=14,\n",
        "        fontweight=\"bold\",\n",
        "    )\n",
        "    ax2.set_xlabel(\"X Coordinates\", fontsize=12)\n",
        "    ax2.set_ylabel(\"Y Coordinates\", fontsize=12)\n",
        "    ax2.grid(True, linestyle=\"--\", alpha=0.6)\n",
        "    ax2.legend()\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# --- Main Execution ---\n",
        "if __name__ == \"__main__\":\n",
        "    np.random.seed(42)\n",
        "    num_cities = 25\n",
        "    city_coordinates = np.random.rand(num_cities, 2) * 100\n",
        "\n",
        "    # Solve TSP with ACO\n",
        "    solver = EnhancedACO_TSP(\n",
        "        cities=city_coordinates, n_iterations=100, beta=2.0\n",
        "    )\n",
        "    best_path, best_dist, history = solver.run()\n",
        "\n",
        "    # Generate Graphs\n",
        "    plot_aco_results(city_coordinates, best_path, history)"
      ]
    }
