        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ---------------- PARAMETERS ----------------\n",
        "POP_SIZE = 100\n",
        "CHROMOSOME_LENGTH = 50\n",
        "GENERATIONS = 300\n",
        "\n",
        "NEIGHBORHOOD_RADIUS = 3\n",
        "WINDOW_SIZE = 20\n",
        "MAX_TRIALS = 10\n",
        "\n",
        "CROSSOVER_RATE = 0.8\n",
        "MUTATION_RATE = 1 / CHROMOSOME_LENGTH\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "\n",
        "# ---------------- FITNESS FUNCTION ----------------\n",
        "# OneMax: maximize the number of 1s in a binary chromosome\n",
        "\n",
        "def fitness(chromosome):\n",
        "    return np.sum(chromosome)\n",
        "\n",
        "\n",
        "# ---------------- INITIALIZATION ----------------\n",
        "population = np.random.randint(\n",
        "    0, 2, (POP_SIZE, CHROMOSOME_LENGTH)\n",
        ")\n",
        "\n",
        "fitness_values = np.array([\n",
        "    fitness(individual) for individual in population\n",
        "])\n",
        "\n",
        "# Each cell has its own acceptance threshold\n",
        "tide = fitness_values.astype(float)\n",
        "\n",
        "# Store historical fitness values for every cell\n",
        "history = [fitness_values.copy()]\n",
        "\n",
        "best_fitness_history = []\n",
        "average_fitness_history = []\n",
        "\n",
        "\n",
        "# ---------------- LOCAL NEIGHBORHOOD ----------------\n",
        "def get_neighbors(index):\n",
        "    return [\n",
        "        (index + offset) % POP_SIZE\n",
        "        for offset in range(\n",
        "            -NEIGHBORHOOD_RADIUS,\n",
        "            NEIGHBORHOOD_RADIUS + 1\n",
        "        )\n",
        "    ]\n",
        "\n",
        "\n",
        "# ---------------- LOCAL PROPORTIONATE SELECTION ----------------\n",
        "def select_parent(neighbor_indices, current_fitness):\n",
        "    weights = current_fitness[neighbor_indices].astype(float)\n",
        "\n",
        "    if np.sum(weights) == 0:\n",
        "        probabilities = np.ones(len(weights)) / len(weights)\n",
        "    else:\n",
        "        probabilities = weights / np.sum(weights)\n",
        "\n",
        "    selected = np.random.choice(\n",
        "        neighbor_indices,\n",
        "        p=probabilities\n",
        "    )\n",
        "\n",
        "    return selected\n",
        "\n",
        "\n",
        "# ---------------- CROSSOVER ----------------\n",
        "def crossover(parent1, parent2):\n",
        "    if np.random.rand() > CROSSOVER_RATE:\n",
        "        return parent1.copy()\n",
        "\n",
        "    point = np.random.randint(1, CHROMOSOME_LENGTH)\n",
        "\n",
        "    offspring = np.concatenate([\n",
        "        parent1[:point],\n",
        "        parent2[point:]\n",
        "    ])\n",
        "\n",
        "    return offspring\n",
        "\n",
        "\n",
        "# ---------------- MUTATION ----------------\n",
        "def mutate(offspring):\n",
        "    for i in range(CHROMOSOME_LENGTH):\n",
        "        if np.random.rand() < MUTATION_RATE:\n",
        "            offspring[i] = 1 - offspring[i]\n",
        "\n",
        "    return offspring\n",
        "\n",
        "\n",
        "# ---------------- CELLULAR GENETIC ALGORITHM ----------------\n",
        "for generation in range(GENERATIONS):\n",
        "\n",
        "    new_population = population.copy()\n",
        "    new_fitness = fitness_values.copy()\n",
        "\n",
        "    # Synchronous update: all cells use the old population\n",
        "    for cell in range(POP_SIZE):\n",
        "\n",
        "        neighbors = get_neighbors(cell)\n",
        "\n",
        "        # Generate offspring until accepted or trials exhausted\n",
        "        for trial in range(MAX_TRIALS):\n",
        "\n",
        "            p1_index = select_parent(\n",
        "                neighbors, fitness_values\n",
        "            )\n",
        "\n",
        "            p2_index = select_parent(\n",
        "                neighbors, fitness_values\n",
        "            )\n",
        "\n",
        "            parent1 = population[p1_index]\n",
        "            parent2 = population[p2_index]\n",
        "\n",
        "            offspring = crossover(parent1, parent2)\n",
        "            offspring = mutate(offspring)\n",
        "\n",
        "            offspring_fitness = fitness(offspring)\n",
        "\n",
        "            # Self-adjusting threshold acceptance\n",
        "            if offspring_fitness > tide[cell]:\n",
        "                new_population[cell] = offspring\n",
        "                new_fitness[cell] = offspring_fitness\n",
        "                break\n",
        "\n",
        "    # Update the population simultaneously\n",
        "    population = new_population\n",
        "    fitness_values = new_fitness\n",
        "\n",
        "    # Save fitness history\n",
        "    history.append(fitness_values.copy())\n",
        "\n",
        "    # Update each cell's threshold using its historical fitness\n",
        "    if generation + 1 >= WINDOW_SIZE:\n",
        "        historical_values = history[\n",
        "            generation + 1 - WINDOW_SIZE\n",
        "        ]\n",
        "\n",
        "        tide = np.maximum(tide, historical_values)\n",
        "\n",
        "    best_fitness_history.append(np.max(fitness_values))\n",
        "    average_fitness_history.append(np.mean(fitness_values))\n",
        "\n",
        "\n",
        "# ---------------- RESULTS ----------------\n",
        "best_index = np.argmax(fitness_values)\n",
        "best_solution = population[best_index]\n",
        "\n",
        "print(\"Best chromosome:\")\n",
        "print(best_solution)\n",
        "\n",
        "print(\"\\nBest fitness:\", fitness(best_solution))\n",
        "print(\"Maximum possible fitness:\", CHROMOSOME_LENGTH)\n",
        "\n",
        "\n",
        "# ---------------- GRAPH 1: CONVERGENCE ----------------\n",
        "plt.figure(figsize=(9, 5))\n",
        "plt.plot(best_fitness_history, label=\"Best fitness\")\n",
        "plt.plot(average_fitness_history, label=\"Average fitness\")\n",
        "plt.xlabel(\"Generation\")\n",
        "plt.ylabel(\"Fitness\")\n",
        "plt.title(\"Cellular Genetic Algorithm - Convergence\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ---------------- GRAPH 2: POPULATION FITNESS ----------------\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(fitness_values, marker=\"o\", linestyle=\"-\")\n",
        "plt.xlabel(\"Cell index\")\n",
        "plt.ylabel(\"Fitness\")\n",
        "plt.title(\"Final Fitness Distribution Across Cellular Population\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ---------------- GRAPH 3: POPULATION HEATMAP ----------------\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.imshow(\n",
        "    population,\n",
        "    aspect=\"auto\",\n",
        "    cmap=\"binary\",\n",
        "    interpolation=\"nearest\"\n",
        ")\n",
        "plt.xlabel(\"Gene position\")\n",
        "plt.ylabel(\"Cell index\")\n",
        "plt.title(\"Final Cellular Population\")\n",
        "plt.colorbar(label=\"Gene value\")\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ---------------- GRAPH 4: ACCEPTANCE THRESHOLDS ----------------\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(tide, marker=\".\")\n",
        "plt.xlabel(\"Cell index\")\n",
        "plt.ylabel(\"Acceptance threshold\")\n",
        "plt.title(\"Final Self-Adjusting Acceptance Thresholds\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
    }
